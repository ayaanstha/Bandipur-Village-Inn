# Form endpoint that receives booking and contact enquiries as a JSON POST.
# Recommended: Formspree (https://formspree.io), whose free plan is 50 submissions/month.
# Copy this file to .env, paste your form's endpoint below, then run `npm run build`.
#
#   VITE_ENQUIRY_ENDPOINT=https://formspree.io/f/abcdwxyz
#
# If left empty, the forms open the visitor's email app instead, with the enquiry
# pre-filled and addressed to info@bandipurvillageinn.com.
VITE_ENQUIRY_ENDPOINT=
